# =============================================================================
# SERVIQO AI — CLOUD DATABASE & BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# NOTE: Do NOT place real production credentials in this template. Store actual
# secrets in your local .env or in your cloud hosting provider's secret manager
# (Render, Railway, Fly.io, AWS Secrets Manager, etc.).

# Cloud MySQL Database Settings (Aiven, TiDB Cloud, Railway, AWS RDS, GCP Cloud SQL)
DB_HOST=your-cloud-mysql-host.example.com
DB_PORT=15761
DB_USER=your_db_username
DB_PASSWORD=your_secure_db_password
DB_NAME=serviqo_ai

# Remote SSL/TLS Security Configuration
# Modes: REQUIRED (default for Aiven/cloud TLS), VERIFY_CA, DISABLED
DB_SSL_MODE=REQUIRED
# Path to Certificate Authority bundle if custom verification is required (optional)
DB_SSL_CA=

# Database Connection Pool Tuning
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT=15

# Backend Server Runtime
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=production

# Application Security
SECRET_KEY=replace_with_a_secure_random_32_character_secret_key

# CORS Security (Comma-separated allowed frontend origins, or * for open access)
ALLOWED_ORIGINS=*

# Optional Administrative Setup
ADMIN_EMAIL=admin@serviqo.ai
ADMIN_PASSWORD=change_this_admin_password
